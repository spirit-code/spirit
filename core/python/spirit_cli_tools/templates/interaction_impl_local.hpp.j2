    {% endif %}
};

template<>
inline scalar {{ name }}::Energy::operator()( Span<const Index> index, quantity<const Vector3 *> state ) const
{
    {% if demo %}
    scalar energy = 0.0;
    for( const Index & idx : index )
    {
        energy -= state.spin[idx.ispin].dot( this->matrices[idx.ipair] * state.spin[idx.jspin] );
    }
    return 0.5 * energy;
    {% else %}
    return Backend::transform_reduce(
        index.begin(), index.end(), scalar( 0.0 ), Backend::plus<scalar>{},
        [this, state] SPIRIT_LAMBDA( const Index & idx ) -> scalar
        {
            // TODO: Add your Energy implementation
            return 0.0;
        } );
    {% endif %}
}

template<>
inline Vector3 {{ name }}::Gradient::operator()( Span<const Index> index, quantity<const Vector3 *> state ) const
{
    {% if demo %}
    Vector3 gradient = Vector3::Zero();
    for( const Index & idx : index )
    {
        gradient -= this->matrices[idx.ipair] * state.spin[idx.jspin];
    }
    return gradient;
    {% else %}
    return Backend::transform_reduce(
        index.begin(), index.end(), Vector3{ 0.0, 0.0, 0.0 }, Backend::plus<Vector3>{},
        [this, state] SPIRIT_LAMBDA( const Index & idx ) -> Vector3
        {
            // TODO: Add your Gradient implementation
            return {0.0, 0.0, 0.0};
        } );
    {% endif %}
}

template<>
template<typename Callable>
void {{ name }}::Hessian::operator()( Span<const Index> index, const StateType &, Callable & hessian ) const
{
    {% if demo %}
    for( const Index & idx : index )
    {
        const int i      = 3 * idx.ispin;
        const int j      = 3 * idx.jspin;
        const auto ipair = idx.ipair;

        for( int alpha = 0; alpha < 3; ++alpha )
        {
            for( int beta = 0; beta < 3; ++beta )
            {
                hessian( i + alpha, j + beta, -this->matrices[ipair](alpha, beta) );
            }
        }
    }
    {% else %}
    Backend::cpu::for_each(
        index.begin(), index.end(),
        [this, &hessian]( const Index & idx )
        {
            // TODO: Add your Hessian implementation
        } );
    {% endif %}
}

