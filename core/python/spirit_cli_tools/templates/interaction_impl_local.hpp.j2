struct {{ name }}
{
    using state_t = StateType;

    struct Data
    {
        Data() = default; // This constructor is required. Don't delete it!
        // TODO: Add whatever data your interaction needs to be configured

        {% if demo %}
        pairfield pairs;
        scalarfield coefficients;
        {% endif %}
    };

    static bool valid_data( const Data & data )
    {
        // NOTE: This is an optional method to validate your data whenever it gets set
        {% if demo %}
        return 6 * data.pairs.size() == data.coefficients.size();
        {% else %}
        return true;
        {% endif %}
    };

    struct Cache
    {
        Cache() = default; // This constructor is required. Don't delete it!
        // NOTE: The cache is populated with data that is dependent on the Geometry

        {% if demo %}
        field<Matrix3> matrices;
        {% endif %}
    };

    static bool is_contributing( const Data & data, const Cache & cache )
    {
        // NOTE: if the current configuration doesn't affect the Hamiltonian it will be skipped
        {% if demo %}
        return !data.pairs.empty();
        {% else %}
        return true;
        {% endif %}
    }

    struct Index
    {
        // TODO: The index data each site needs to calculate the local contribution.
        // It is passed as a span to the Energy, Gradient and Hessian methods defined below.
        {% if demo %}
        int ispin = 0, jspin = 0, ipair = 0;
        {% endif %}
    };

    using IndexContainer = Engine::IndexContainer<{{ name }}>;

    // These are the default implementations that hook into
    using Energy   = Functor::Local::Energy_Functor<Functor::Local::DataRef<{{ name }}>>;
    using Gradient = Functor::Local::Gradient_Functor<Functor::Local::DataRef<{{ name }}>>;
    using Hessian  = Functor::Local::Hessian_Functor<Functor::Local::DataRef<{{ name }}>>;

    static std::size_t Sparse_Hessian_Size_per_Cell( const Data & data, const Cache & cache )
    {
        // TODO: How many terms contribute to the Hessian for each cell?
        {% if demo %}
        return cache.matrices.size() * 9;
        {% else %}
        return 0;
        {% endif %}
    };

    // Calculate the total energy for a single spin to be used in Monte Carlo.
    //      Note: therefore the energy of pairs is weighted x2 and of quadruplets x4.
    using Energy_Single_Spin = Functor::Local::Energy_Single_Spin_Functor<Energy, 1>;

    // Interaction name as string
    static constexpr std::string_view name = R"(Custom: {{ full_name }})";

    static void
    applyGeometry( const ::Data::Geometry & geometry, const Data & data, Cache & cache, IndexContainer & container )
    {
        using Indexing::idx_from_pair;
        {% if demo %}
        // convert (eigen vector, eigen value) pairs to symmetrical matrices
        cache.matrices = field<Matrix3>( data.pairs.size(), Matrix3::Zero() );
        for( unsigned int imatrix = 0; imatrix < cache.matrices.size(); ++imatrix )
        {
            const scalar Kxx = data.coefficients[6 * imatrix + 0];
            const scalar Kyy = data.coefficients[6 * imatrix + 1];
            const scalar Kzz = data.coefficients[6 * imatrix + 2];
            const scalar Kyz = data.coefficients[6 * imatrix + 3];
            const scalar Kxz = data.coefficients[6 * imatrix + 4];
            const scalar Kxy = data.coefficients[6 * imatrix + 5];
            cache.matrices[imatrix] << Kxx, Kxy, Kxz, Kxy, Kyy, Kyz, Kxz, Kyz, Kzz;
        }

        // calculate local indices based off provided pairs
        auto indices = std::vector( geometry.nos, field<Index>{} );
        for( int icell = 0; icell < geometry.n_cells_total; ++icell )
        {
            for( int ipair = 0; ipair < data.pairs.size(); ++ipair )
            {
                int ispin = data.pairs[ipair].i + icell * geometry.n_cell_atoms;
                int jspin = Indexing::idx_from_pair(
                    ispin, geometry.boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                    data.pairs[ipair] );
                if( jspin >= 0 )
                {
                    indices[ispin].push_back( Index{ ispin, jspin, ipair } );
                    indices[jspin].push_back( Index{ jspin, ispin, ipair } );
                }
            }
        }
        {% else %}
        auto indices = std::vector( geometry.nos, field<Index>{} );

        // TODO: Define the indices that contribute to each local Hamiltonian.
        {% endif %}

        container = make_index_container<{{ name }}>( std::move( indices ) );
    };
};

