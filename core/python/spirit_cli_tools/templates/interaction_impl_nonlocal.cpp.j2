template<>
Vector3 {{ name }}::Gradient_Local::operator()( const int ispin, const StateType & state ) const
{
    // TODO: implement this if you want to use the MC module with this interaction.
    // It should be able to calculate the local gradient more efficiently than the implementation below.
    // The function object has access to references of the data and cache values.

    {% if demo %}
    Vector3 gradient = Vector3::Zero();
    if( !cache.geometry || !cache.boundary_conditions )
        return gradient;

    const auto & geometry            = *cache.geometry;
    const auto & boundary_conditions = *cache.boundary_conditions;
    const int icell                  = ispin / geometry.n_cell_atoms;
    const int ibasis                 = ispin - icell * geometry.n_cell_atoms;
    for( unsigned int ipair = 0; ipair < data.pairs.size(); ++ipair )
    {
        const auto & pair = data.pairs[ipair];
        if( pair.i == ibasis )
        {
            int jspin = Indexing::idx_from_pair(
                ispin, boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                pair );
            if( jspin >= 0 )
                gradient -= cache.matrices[ipair] * state.spin[jspin];
        }
        if( pair.j == ibasis )
        {
            const auto & t      = pair.translations;
            const auto pair_inv = Pair{ pair.j, pair.i, { -t[0], -t[1], -t[2] } };
            int jspin           = Indexing::idx_from_pair(
                ispin, boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                pair_inv );
            if( jspin >= 0 )
                gradient -= cache.matrices[ipair] * state.spin[jspin];
        }
    }
    return gradient;
    {% else %}
    vectorfield gradient( state.spin.size(), Vector3::Zero() );
    std::invoke( {{ name }}::Gradient( data, cache ), state, gradient );
    return gradient[ispin];
    {% endif %}
};

// Calculate the total energy for a single spin to be used in Monte Carlo.
//      Note: therefore the energy of pairs is weighted x2 and of quadruplets x4.
template<>
scalar {{ name }}::Energy_Single_Spin::operator()( const int ispin, const StateType & state ) const
{
    // TODO: implement this if you want to use the MC module with this interaction.
    // It should be able to calculate the local gradient more efficiently than the implementation below.
    // The function object has access to references of the data and cache values.

    {% if demo %}
    scalar energy = 0.0;
    if( !cache.geometry || !cache.boundary_conditions )
        return energy;


    const auto & geometry            = *cache.geometry;
    const auto & boundary_conditions = *cache.boundary_conditions;
    const int icell                  = ispin / geometry.n_cell_atoms;
    const int ibasis                 = ispin - icell * geometry.n_cell_atoms;
    for( unsigned int ipair = 0; ipair < data.pairs.size(); ++ipair )
    {
        const auto & pair = data.pairs[ipair];
        if( pair.i == ibasis )
        {
            int jspin = Indexing::idx_from_pair(
                ispin, boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                pair );
            if( jspin >= 0 )
                energy -= state.spin[ispin].dot( cache.matrices[ipair] * state.spin[jspin] );
        }
        if( pair.j == ibasis )
        {
            const auto & t      = pair.translations;
            const auto pair_inv = Pair{ pair.j, pair.i, { -t[0], -t[1], -t[2] } };
            int jspin           = Indexing::idx_from_pair(
                ispin, boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                pair_inv );
            if( jspin >= 0 )
                energy -= state.spin[ispin].dot( cache.matrices[ipair] * state.spin[jspin] );
        }
    }
    return energy;
    {% else %}
    scalarfield energy( state.spin.size(), 0.0 );
    std::invoke( {{ name }}::Energy( data, cache ), state, energy );
    return energy[ispin];
    {% endif %}
};

