void {{ name }}::applyGeometry(
    const ::Data::Geometry & geometry, const intfield & boundary_conditions, const Data & data, Cache & cache )
{
    // TODO: Here you can precaclulate some values that depend on the Geometry and store them in the cache

    {% if demo  %}
    // convert (eigen vector, eigen value) pairs to symmetrical matrices
    cache.matrices = field<Matrix3>( data.pairs.size(), Matrix3::Zero() );
    for( unsigned int imatrix = 0; imatrix < cache.matrices.size(); ++imatrix )
    {
        for( unsigned int alpha = 0; alpha < 3; ++alpha )
        {
            const scalar Kxx = data.coefficients[6 * imatrix + 0];
            const scalar Kyy = data.coefficients[6 * imatrix + 1];
            const scalar Kzz = data.coefficients[6 * imatrix + 2];
            const scalar Kyz = data.coefficients[6 * imatrix + 3];
            const scalar Kxz = data.coefficients[6 * imatrix + 4];
            const scalar Kxy = data.coefficients[6 * imatrix + 5];
            cache.matrices[imatrix] << Kxx, Kxy, Kxz, Kxy, Kyy, Kyz, Kxz, Kyz, Kzz;
        }
    }

    cache.geometry            = &geometry;
    cache.boundary_conditions = &boundary_conditions;
    {% endif %}
}

template<>
void {{ name }}::Energy::operator()( const StateType & state, scalarfield & energy ) const
{
    // TODO: Implement how to calculate the local energy for the {{ name }} interaction
    // The function object has access to references of the data and cache values.
    // Always add to the value present at each position.

    {% if demo %}
    if( !cache.geometry || !cache.boundary_conditions )
        return;

    const auto & geometry            = *cache.geometry;
    const auto & boundary_conditions = *cache.boundary_conditions;
    for( unsigned int icell = 0; icell < geometry.n_cells_total; ++icell )
    {
        for( unsigned int ipair = 0; ipair < data.pairs.size(); ++ipair )
        {
            const int ispin = data.pairs[ipair].i + icell * geometry.n_cell_atoms;
            const int jspin = Indexing::idx_from_pair(
                ispin, boundary_conditions, geometry.n_cells, geometry.n_cell_atoms, geometry.atom_types,
                data.pairs[ipair] );
            if( jspin >= 0 )
            {
                energy[ispin] -= 0.5 * state.spin[ispin].dot( cache.matrices[ipair] * state.spin[jspin] );
                energy[jspin] -= 0.5 * state.spin[jspin].dot( cache.matrices[ipair] * state.spin[ispin] );
            }
        }
    }
    {% endif %}
};

template<>
void {{ name }}::Gradient::operator()( const StateType & state, vectorfield & gradient ) const
{
    // TODO: Implement how to calculate the local gradients for the {{ name }} interaction
    // The function object has access to references of the data and cache values.
    // Always add to the value present at each position.

    {% if demo %}
    if( !cache.geometry || !cache.boundary_conditions )
